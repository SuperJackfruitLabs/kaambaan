{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "superpipeline-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // Workers Observability → superwitness (ws4). Traces go only to the gateway (`persist: false`
  // stores nothing in Cloudflare). Logs stay persisted as before AND go to the gateway. The
  // sampling rate comes from the measurement in ws4 Task 15 Step 1. Change it only with a new
  // measurement.
  // The destinations `superwitness-traces` and `superwitness-logs` must exist in the account
  // before this config is deployed.
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1,
      "destinations": ["superwitness-logs"],
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "destinations": ["superwitness-traces"],
      "persist": false
    }
  },
  // NOTE: DEV_AUTH is deliberately NOT set here. Dev-mode auth (accepting X-Tenant-Id / X-Agent-Id
  // headers as a credential) is opt-IN: `pnpm dev` passes `--var DEV_AUTH:true` and the test runner
  // sets it in vitest.config.ts. Setting it here would make every `wrangler deploy` that forgot to
  // override it ship an app where any X-Tenant-Id header is a full credential for that tenant.
  // The suite's token issuer (charter decisions/2026-08-15-one-issuer-and-offline-verification.md).
  //
  // Safe to set here, unlike DEV_AUTH above, because it is not a credential and it grants nothing on
  // its own: it names WHO we will believe, and a token still has to verify against that issuer's
  // published JWKS and then map its `fleet_` tenant onto one of ours. An unset value means the path
  // is off; a wrong value means every hub token is refused. Neither fails open.
  // ORG_PLANE_ISSUER / ORG_PLANE_JWKS_URL / ORG_PLANE_AUDIENCE / ORG_PLANE_URL switch this deployment
  // to the Organization plane (src/auth/org-plane.ts). Set at the P4 cutover (accounts
  // docs/superpowers/plans/2026-10-06-p4-cutover.md step 2.4): from this deploy on, every hub token
  // is refused. There is no dual-accept; rollback is reverting this change. See docs/12-deploy.md.
  "vars": {
    // The Organization plane (accounts issuer contract §1, production values). Plain vars, not
    // secrets: they name whom to believe and grant nothing. They change only through a merged PR,
    // because CI's `wrangler deploy` on every merge would drop a hand-set `--var`.
    "ORG_PLANE_ISSUER": "https://accounts.superjackfruit.com",
    "ORG_PLANE_JWKS_URL": "https://accounts.superjackfruit.com/api/auth/jwks",
    "ORG_PLANE_AUDIENCE": "https://app.superpipeline.dev",
    "ORG_PLANE_URL": "https://accounts.superjackfruit.com",
    // Kept under the plane: it no longer names an issuer this Worker trusts, it names the hub's
    // resource, which the web client requests as a second token for the assignee picker.
    "HUB_ISSUER": "https://hub.agentpod.dev",
    // This deployment's own origin — the `redirect_uri` we register with the hub AND the `aud`
    // we now demand of every hub token (`auth/hub-jwt.ts`, `planeAudience`).
    //
    // Pinned rather than left to fall back on the request's origin, because this Worker answers
    // on more than one host. With the fallback, the audience demanded would be whichever host the
    // caller typed, so a token minted for the registered origin would be refused on the other —
    // and the registered `redirect_uri` would change shape with the Host header, which the hub
    // matches as a whole string.
    //
    // Safe here for the same reason HUB_ISSUER is: it is not a credential and grants nothing. A
    // wrong value refuses every hub token and registers a redirect the hub does not know. Both
    // fail closed.
    "APP_URL": "https://app.superpipeline.dev",
    // The control pair is enforced: a card is claimable only if the grant
    // recorded when it was queued permits the claiming agent
    // (charter decisions/2026-08-13-ecosystem-identity.md, Decision 4).
    //
    // Safe here for the same reason HUB_ISSUER is — it grants nothing, it only
    // decides whether a recorded grant is CHECKED, and every path fails closed.
    //
    // A card queued WITHOUT an authorising token parks in input-required and
    // says why. That is why the web app now carries a hub token (see
    // apps/web/src/lib/hub-token.ts): before it did, enabling this would have
    // made the board unusable through its own UI (superpipeline#43).
    "ENFORCE_CONTROL_PAIR": "true",
    // Run reporting to superwitness (superwitness app spec §3.5). Not a credential: it names where
    // reports go; the credential is the SUPERWITNESS_REPORTER_CREDENTIAL secret. Removing this line
    // turns reporting off (no outbox writes).
    "SUPERWITNESS_URL": "https://app.superwitness.dev"
  },
  // The push delivery queue drains here, on a schedule.
  //
  // `POST /v1/boards/:id/push/dispatch` has always existed and nothing called it on a timer: the
  // queue drained only on a DO alarm or a manual POST, so a delivery whose alarm was missed sat
  // there indefinitely. Five minutes is chosen against the delivery's own five-attempt backoff —
  // frequent enough that a missed alarm is a delay rather than a loss, rare enough that a
  // deployment with no pending deliveries costs almost nothing.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "superpipeline-catalog",
      "database_id": "62bba503-d61c-4318-8c30-a74f1ffa71ae",
      "migrations_dir": "migrations"
    }
  ],
  // The hostnames this Worker answers on, declared here rather than clicked
  // into the dashboard — the rename made the dashboard's copy the only record
  // of which Worker owned which host, and that record does not survive a
  // script being replaced.
  "routes": [
    { "pattern": "app.superpipeline.dev", "custom_domain": true }
  ],
  "durable_objects": {
    "bindings": [{ "name": "BOARD_DO", "class_name": "BoardDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BoardDO"] }],
  // Serve the web SPA same-origin: static files are served directly; non-file routes fall back to
  // index.html, and the Worker handles /v1, /auth, /mcp, /health (build: `pnpm --filter @superpipeline/web build`).
  "assets": {
    "directory": "../web/build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Run the Worker first for API routes so the SPA fallback never shadows them (a browser
    // navigation to /auth/login must hit the Worker, not get served index.html).
    //
    // `/hub/*` is on this list for a sharper version of the same reason: the hub redirects a
    // browser to /hub/callback, and without this the assets layer would answer that navigation
    // with index.html — the code would be dropped on the floor and the operator would land on a
    // board that looks fine and still has no authority, which is precisely the silent failure
    // this whole flow exists to end.
    "run_worker_first": ["/v1/*", "/auth/*", "/hub/*", "/mcp", "/health", "/.well-known/oauth-protected-resource", "/.well-known/oauth-protected-resource/*"]
  }
}
